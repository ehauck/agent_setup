#!/usr/bin/env bash
set -euo pipefail

source "$HOME/.firecracker-codex/bin/fc-env"

sudo ip link del "$FC_TAP" 2>/dev/null || true

sudo ip tuntap add dev "$FC_TAP" mode tap user "$USER"
sudo ip addr add "$FC_HOST_IP/30" dev "$FC_TAP"
sudo ip link set "$FC_TAP" up

sudo sysctl -w net.ipv4.ip_forward=1 >/dev/null

HOST_IFACE="$(ip route show default | awk '{print $5; exit}')"

sudo iptables -t nat -C POSTROUTING \
    -s 172.16.0.0/30 \
    -o "$HOST_IFACE" \
    -j MASQUERADE 2>/dev/null ||
sudo iptables -t nat -A POSTROUTING \
    -s 172.16.0.0/30 \
    -o "$HOST_IFACE" \
    -j MASQUERADE

sudo iptables -C FORWARD \
    -i "$FC_TAP" \
    -o "$HOST_IFACE" \
    -j ACCEPT 2>/dev/null ||
sudo iptables -A FORWARD \
    -i "$FC_TAP" \
    -o "$HOST_IFACE" \
    -j ACCEPT

sudo iptables -C FORWARD \
    -i "$HOST_IFACE" \
    -o "$FC_TAP" \
    -m conntrack \
    --ctstate RELATED,ESTABLISHED \
    -j ACCEPT 2>/dev/null ||
sudo iptables -A FORWARD \
    -i "$HOST_IFACE" \
    -o "$FC_TAP" \
    -m conntrack \
    --ctstate RELATED,ESTABLISHED \
    -j ACCEPT
